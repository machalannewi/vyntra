    "bcryptjs": "3.0.2",
    "framer-motion": "^14.4.0",
    "jose": "6.1.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2"
  }
