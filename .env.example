# Database: Postgres (e.g. Neon). Pooled URL for the app, unpooled URL for migrations (names match Vercel's Neon integration).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Long random string used to sign login sessions
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL of the site (used for Paystack callback)
APP_URL="http://localhost:3000"

# Paystack (https://dashboard.paystack.com/#/settings/developers)
# Leave empty in development to use the built-in simulated top-up.
PAYSTACK_SECRET_KEY=""

# Number provider: "mock" (dev, fake numbers) or "twilio"
NUMBER_PROVIDER="mock"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@vyntra.local"
ADMIN_PASSWORD="change-me"

# Optional local test customer
TEST_USER_EMAIL="testbuyer@example.com"
TEST_USER_PASSWORD="change-me"
